{
  "name": "luong-hak",
  "version": "2.0.64",
  "description": "Tính lương HAK - chạy offline",
  "main": "main.js",
  "author": "HAK",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "build:app": "node scripts/build-app.cjs",
    "sqlite:shadow": "node --no-warnings tools/sqlite-shadow.js",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\" \"tests/regression/*.test.js\"",
    "test:e2e": "node tests/e2e/run-e2e.js",
    "test:ui-dom": "node tests/e2e/drawer-dom-check.cjs",
    "test:workspace": "node tests/e2e/v104-workspace-check.js",
    "dist": "electron-builder --win nsis --x64",
    "test:ocr-eval": "node tests/e2e/ocr-eval.js"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "eslint": "10.15.0",
    "jsdom": "31.0.1"
  },
  "build": {
    "appId": "vn.hak.luong",
    "productName": "Tinh Luong HAK",
    "files": [
      "main.js",
      "preload.js",
      "main/**",
      "core/**",
      "ui/**",
      "index.html",
      "style.css",
      "app.js",
      "engine.js",
      "hr.js",
      "xlsx.full.min.js",
      "exceljs.min.js",
      "vendor/**",
      "ocr/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Tính Lương HAK",
      "menuCategory": "HAK",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "Tính Lương HAK ${version}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "TinhLuongHAK-V10.4-Setup-${version}.${ext}",
    "directories": {
      "buildResources": "build"
    },
    "asarUnpack": [
      "node_modules/**",
      "ocr/**"
    ]
  },
  "dependencies": {
    "tesseract.js": "7.0.0"
  }
}
